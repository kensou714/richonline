.if (dwo(0xA7672C) != 0) { .printf "queue_pause=%u queue_read=%u queue_write=%u delay_ms=%u delay_started=%u calendar=%u\n", by(dwo(0xA7672C)+0x14777), dwo(dwo(0xA7672C)+0x64C), dwo(dwo(0xA7672C)+0x650), dwo(dwo(0xA7672C)+0xC), dwo(dwo(0xA7672C)+0x10), dwo(dwo(0xA7672C)+0xC48) }
