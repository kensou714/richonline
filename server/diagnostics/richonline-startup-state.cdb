.if (dwo(0xA76728) != 0) { .printf "profile_table=%08x profile_capacity=%u\n", dwo(dwo(0xA76728)+0x4D4), dwo(dwo(0xA76728)+0x4D8) }
.if (dwo(0xA76728) != 0) { .if (dwo(dwo(0xA76728)+0x4D4) != 0) { .if (dwo(dwo(0xA76728)+0x4D8) > 26) { .printf "profile_slot26_pointer=%08x\n", dwo(dwo(dwo(0xA76728)+0x4D4)+0x68) } } }
