# Only documentation and server source belong in this repository.
/*
!/.gitignore
!/README.md
!/docs/
!/server/
!/resource-manager/
!/item-catalog/

# Client media exported for the local catalog remains outside source control.
/item-catalog/public/images/
/item-catalog/public/audio/
/item-catalog/contact-sheet.png
*.decoded.bin

# Build outputs, local runtime data and credentials.
**/build*/
**/bin/
**/obj/
**/publish/
**/test-artifacts/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/logs/
**/backups/
**/vendor/downloads/
*.exe
*.dll
*.obj
*.o
*.a
*.lib
*.pdb
*.pyc
*.log
*.sqlite3*
*.db
*.db-*
*.dmp
.env
.env.*
*.pem
*.key
*.pfx
*.p12
